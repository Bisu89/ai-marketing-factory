# Used only by `npm run build` (production builds), never by `npm run dev`.
# In the packaged desktop app, the frontend is served by the same FastAPI
# process that serves the API (see backend/app/main.py's SPA static mount),
# on a dynamically-assigned port (launcher.py) -- so the API must be
# reached with a relative path, not the dev-only absolute
# http://127.0.0.1:8000 default in src/config/env.ts.
VITE_API_BASE_URL=/api/v1
